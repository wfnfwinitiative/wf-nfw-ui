# Google Maps Configuration (live driver tracking)
# Requires Maps JavaScript API, Geolocation API, Directions API enabled
VITE_GOOGLE_MAPS_API_KEY=AIzaSyCCMCb7LDey95lkmeip_GfR3wh6LTcJA_c

# Set to false to use real driver location + real road directions
VITE_MOCK_TRACKING=false

# LLM Service Configuration
# URL for the LLM service that processes voice/audio input
# Example: http://localhost:8000 or https://wf-nfw-llm-services.vercel.app
VITE_LLM_SERVICE_URL=http://localhost:9000

# Backend Service Configuration
# URL for the backend service that manages feature flags, data, etc.
# Example: https://wf-nfw-services-two.vercel.app
#VITE_BACKEND_SERVICE_URL=https://wf-nfw-services-two.vercel.app
VITE_BACKEND_SERVICE_URL=http://localhost:8000
